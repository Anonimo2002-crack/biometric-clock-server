// MySQL local (Workbench: asistencia_db). En Debian usa el mismo provider.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
  interface            = "asyncio"
}

// Alumno también cubre catedráticos y el admin del aparato (campo rol).
model Alumno {
  id         Int          @id @default(autoincrement())
  nombre     String
  codigo     String       @unique
  employeeNo String       @unique
  grado      String?
  cargo      String?
  // Datos que llena la dirección. El teléfono es obligatorio para alumnos y el
  // correo solo se usa si quieren avisos por SMTP.
  fechaNacimiento DateTime?
  telefonoPadres  String?
  correoPadres    String?
  rol           String       @default("ALUMNO")
  activo        Boolean      @default(true)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @default(now()) @updatedAt
  marcajes      Asistencia[]

  @@map("alumnos")
}

// Cuentas del tablero web. Distinto del rol ALUMNO/CATEDRATICO del reloj.
model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  usuario       String   @unique
  passwordHash  String
  rol           String
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @default(now()) @updatedAt

  @@map("usuarios")
}

model Asistencia {
  id            Int      @id @default(autoincrement())
  alumnoId      Int
  fechaHora     DateTime
  tipo          String
  metodo        String   @default("ROSTRO")
  serialEvento  String?  @unique
  dispositivoIp String?
  creadoEn      DateTime @default(now())
  alumno        Alumno   @relation(fields: [alumnoId], references: [id])

  @@index([fechaHora])
  @@index([alumnoId, fechaHora])
  @@map("asistencias")
}
