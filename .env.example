# Copia este archivo a .env y ajusta los valores.
# En la escuela cambia DEVICE_IP y DEVICE_IP_2 (las que asigne el router).
#
# MySQL local (Workbench → asistencia_db). En Debian es la misma forma.
DATABASE_URL="mysql://root:TU_CLAVE@localhost:3306/asistencia_db"

DEVICE_IP=192.168.1.21
# Segundo reloj. Déjalo vacío si todavía hay uno solo.
DEVICE_IP_2=
# Solo si el segundo reloj tiene usuario o clave distintos al primero.
# Las claves de Hikvision distinguen mayusculas de minusculas.
DEVICE_USER_2=
DEVICE_PASS_2=
DEVICE_USER=admin
DEVICE_PASS=cambia-esta-clave
DEVICE_TIMEOUT=10

JWT_SECRET=cambia-este-secreto-en-el-servidor
JWT_HOURS=12
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin123

# Origen del frontend. * sirve en desarrollo.
CORS_ORIGINS=*

# Correo de la escuela. Sale de SMTP_FROM hacia el correo de los padres
# de cada alumno. SMTP_TO es una copia para la escuela (opcional).
# Gmail: contraseña de aplicación de 16 letras, sin espacios. No uses la clave normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Valores iniciales. Dirección los cambia en el tablero: Avisos → Ajustes.
SMTP_AUTO_HORA=16:00
SMTP_AUTO_TARDE=13:15

# true solo en la laptop, para ver el tablero sin el reloj.
# SEED_DEMO=true
