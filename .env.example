# Copia este archivo a .env y ajusta los valores.
# En la escuela solo cambia DEVICE_IP (la que asigne el router de allá).
#
# SQLite en la laptop (cero servidor). En Debian/MySQL sería:
# DATABASE_URL=mysql://usuario:clave@localhost:3306/asistencia_db
# y en schema.prisma: provider = "mysql"

DATABASE_URL="file:./asistencia.db"

DEVICE_IP=192.168.1.21
DEVICE_USER=admin
DEVICE_PASS=cambia-esta-clave
DEVICE_TIMEOUT=10

# Origen del frontend de Geovany. * sirve en desarrollo.
CORS_ORIGINS=*

# true solo en la laptop, para ver el tablero sin el reloj.
# SEED_DEMO=true
